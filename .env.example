# --- AI provider (default: ollama) ---
AI_PROVIDER=ollama

# Ollama model name (`ollama list`)
OLLAMA_MODEL=llama3.2

# Optional: Ollama HTTP API (default: http://127.0.0.1:11434)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: request timeout in ms (default: 240000)
# OLLAMA_TIMEOUT_MS=300000

# Embeddings model for ATS semantic score (pull: ollama pull nomic-embed-text). Falls back to TF–IDF if unavailable.
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Skip Ollama embedding calls for ATS semantic score — use fast TF–IDF only (saves ~10–60s per generate on CPU).
# ATS_SKIP_EMBEDDINGS=true

# Fewer validation repair rounds if the model usually passes (1–5, default 3). Lower = faster but may return imperfect JSON.
# RESUME_MAX_ATTEMPTS=2

# Cap Ollama output tokens for resume JSON (1024–8192). Lower = faster; too low may truncate JSON.
# OLLAMA_NUM_PREDICT=3072

# OpenAI (when AI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (when AI_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional: append structured logs to logs/app.log
# LOG_TO_FILE=true

# File log redaction for sensitive keys (job text, resumes, etc.). Default: on. Disable only on trusted local dev:
# LOG_REDACT_FILE=false

# Optional: verbose debug logs to console/file
# DEBUG_LOGS=true

# Optional: Chrome/Chromium path for PDF (if Puppeteer's cached browser is missing)
# macOS example:
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# --- MongoDB Atlas (optional — profile, saved versions, interview prep cache) ---
# Replace <db_password> with your Atlas user password. Database name: resume_studio
# MONGODB_URI=mongodb+srv://USER:<db_password>@cluster0.zysvtxr.mongodb.net/?appName=Cluster0
# If the URI has no database path, set:
# MONGODB_DB=resume_studio
